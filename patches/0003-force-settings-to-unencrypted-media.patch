From 9a8b7c6d5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b Mon Sep 17 00:00:00 2001
From: async202 <96576912+async202@users.noreply.github.com>
Date: Sat, 13 Jun 2026 12:00:00 +0300
Subject: [PATCH] twrp: align settings storage path with unencrypted data media

---
 data.cpp | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/data.cpp b/data.cpp
--- a/data.cpp
+++ b/data.cpp
@@ -120,7 +120,7 @@
 
 string DataManager::GetSettingsStoragePath()
 {
-	return Settings_Storage_Path;
+	return "/data/media";
 }
 
 int DataManager::LoadValues(string filename)
@@ -300,6 +300,7 @@
 
 int DataManager::LoadValues(string filename)
 {
+	filename = "/data/media/TWRP/.twrps";
 	if (filename.empty())
 		return -1;
 
@@ -315,10 +316,10 @@
 int DataManager::SaveValues()
 {
 #ifndef TW_OEM_BUILD
-	if (mBackingFile.empty())
-		return -1;
-
-	string filename = mBackingFile;
+	string filename = "/data/media/TWRP/.twrps";
+	TWFunc::Recursive_Make_Dir("/data/media/TWRP");
 	string temporary_file = filename + ".tmp";
 	ofstream valuesFile(temporary_file.c_str());
 	if (!valuesFile.is_open())
